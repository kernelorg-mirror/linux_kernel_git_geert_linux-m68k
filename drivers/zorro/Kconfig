# Zorro configuration
#

if ZORRO

config ZORRO_NAMES
	bool "Zorro device name database"
	help
	  By default, the kernel contains a database of all known Zorro device
	  names to make the information in /proc/iomem comprehensible to the
	  user. This database increases the size of the kernel image by about
	  15KB, but it gets freed after the system boots up, so it doesn't
	  take up kernel memory. Anyway, if you are building an installation
	  floppy or kernel for an embedded system where kernel image size
	  really matters, you can disable this feature and you'll get device
	  ID numbers instead of names.

	  When in doubt, say Y.


# Zorro multifunction drivers

config ARIADNE_MFD
	tristate "Ariadne multifunction driver"
	select MFD_CORE
	help
	  If you have a Village Tronic Ariadne Ethernet Card and Parallel
	  Ports adapter, say Y.  Otherwise, say N.

	  To compile this driver as a module, choose M here: the module
	  will be called ariadne-mfd.

config ARIADNE2_MFD
	tristate "Ariadne II multifunction driver"
	select MFD_CORE
	select ZORRO8390 if NETDEVICES && ETHERNET && NET_VENDOR_NATSEMI && NET_VENDOR_8390
	help
	  If you have a Village Tronic Ariadne II Ethernet Card, say Y.
	  Otherwise, say N.

	  To compile this driver as a module, choose M here: the module
	  will be called ariadne2-mfd.

config BUDDHA_MFD
	tristate "Buddha multifunction driver"
	select MFD_CORE
	select BLK_DEV_BUDDHA if IDE
	help
	  If you have an Individual Computers Buddha IDE Interface adapter,
	  say Y.  Otherwise, say N.

	  To compile this driver as a module, choose M here: the module
	  will be called buddha-mfd.

config CATWEASEL_MFD
	tristate "Catweasel multifunction driver"
	select MFD_CORE
	help
	  If you have an Individual Computers Catweasel IDE Interface and
	  Floppy Controller adapter, say Y.  Otherwise, say N.

	  To compile this driver as a module, choose M here: the module
	  will be called catweasel-mfd.

config XSURF_MFD
	tristate "X-Surf multifunction driver"
	select MFD_CORE
	help
	  If you have an Individual Computers X-Surf Ethernet Card and IDE
	  Interface adapter, say Y.  Otherwise, say N.

	  To compile this driver as a module, choose M here: the module
	  will be called catweasel-mfd.


# FIXME Dummy cell drivers

# FIXME Convert existing ARIADNE driver to cell driver
