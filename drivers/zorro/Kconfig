	tristate "Dummy Ariadne network driver"
	depends on ARIADNE_MFD
	help
	  TODO

config ARIADNE_PAR
	tristate "Dummy Ariadne parport driver"
	depends on ARIADNE_MFD
	help
	  TODO

# FIXME Convert existing BLK_DEV_BUDDHA driver to cell driver
config BUDDHA_IDE
	tristate "Dummy Buddha IDE driver"
	depends on BUDDHA_MFD || CATWEASEL_MFD || XSURF_MFD

config CATWEASEL_FLOPPY
	tristate "Dummy Catweasel floppy driver"
	depends on CATWEASEL_MFD

# FIXME Convert existing ZORRO8390 driver to cell driver
config 8390_CELL
	tristate "Dummy 8390 network driver"
	depends on ARIADNE2_MFD || XSURF_MFD

endif
